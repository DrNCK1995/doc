# Database (PostgreSQL)
# Docker Compose default:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/growth_monitor?schema=public"

# Embedded local Postgres (npm run db:local) uses port 54329:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/growth_monitor?schema=public"

# App
NEXT_PUBLIC_APP_NAME="Dr. Chaitanya Growth Monitor"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_PASSWORD="change-me-in-production"

# Patient ID prefix (clinic code)
PATIENT_ID_PREFIX="ARJ"
