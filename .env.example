# Database (PostgreSQL)
# Local Docker Compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/growth_monitor?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/growth_monitor?schema=public"

# Embedded local Postgres (npm run db:local) uses port 54329:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/growth_monitor?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54329/growth_monitor?schema=public"

# Production (pick ONE: Neon OR Prisma Postgres — not both):
# Neon usually provides:
#   DATABASE_URL (+ DATABASE_URL_UNPOOLED)
# Prisma Postgres usually provides:
#   DATABASE_URL (+ DIRECT_URL)
# Build script maps either name to what Prisma needs.
#
# Remove any DATABASE_URL that contains 127.0.0.1 or localhost.

# App
NEXT_PUBLIC_APP_NAME="Dr. Chaitanya Growth Monitor"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Patient ID prefix (clinic code)
PATIENT_ID_PREFIX="ARJ"

# Consult booking — Razorpay (live payments)
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."
# NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Email confirmations + reminders (Resend)
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="Dr Care for Kids <bookings@yourdomain.com>"
# DOCTOR_NOTIFY_EMAIL="doctor@example.com"

# Doctor appointments list + cron
# APPOINTMENTS_ADMIN_SECRET="long-random-string"
# CRON_SECRET="long-random-string"

# Parent / admin login for My Child + Grow Right (other tools stay open)
# Defaults if unset: login DrNCK1995 / password CARE@kids2026
ADMIN_LOGIN_ID="DrNCK1995"
ADMIN_PASSWORD="CARE@kids2026"
# Optional: separate secret for parent session cookies
# PARENT_SESSION_SECRET="long-random-string"

